  "workers": {
    "self": {
      "label": "Host Agent (主模型)",
      "description": "纯问答/设计讨论、≤2 个文件的小修小改、派发前分析与派发后实证验收",
      "keywords": [
        "解释",
        "为什么",
        "方案对比",
        "架构讨论",
        "小改",
        "改一行",
        "typo",
        "explain",
        "question"
      ]
    },
    "codex": {
      "label": "Codex CLI",
      "description": "中大型编码实现、跨文件重构、测试编写、严格沙箱改代码、Code Review",
      "keywords": [
        "重构",
        "refactor",
        "测试",
        "unit test",
        "integration test",
        "review",
        "代码审查",
        "实现",
        "模块",
        "typescript",
        "rust",
        "python",
        "bugfix",
        "修复",
        "migration",
        "沙箱"
      ]
    },
    "dsh": {
      "label": "DeepSeek Harness (dsh)",
      "description": "通用脚本与自动化、文档与调研总结、中文重上下文任务、dsh 插件生态任务及 Codex 限额兜底",
      "keywords": [
        "脚本",
        "script",
        "自动化",
        "调研",
        "总结",
        "文档",
        "readme",
        "markdown",
        "翻译",
        "分析报告",
        "中文",
        "dsh",
        "批量"
      ]
    },
    "claude": {
      "label": "Claude Code CLI",
      "description": "复杂架构重构、代码审查、全栈开发（需在 enabledWorkers 中启用或用 --worker claude 指定）",
      "keywords": [
        "claude",
        "architecture",
        "设计模式",
        "前端组件"
      ]
    },
    "gemini": {
      "label": "Gemini CLI",
      "description": "超大上下文代码库梳理、多文件分析与调研（需在 enabledWorkers 中启用或用 --worker gemini 指定）",
      "keywords": [
        "gemini",
        "全库分析",
        "repo survey"
      ]
    },
    "qwen": {
      "label": "Qwen Code CLI",
      "description": "通用脚本编写、中英文编码辅助与低成本分流（需在 enabledWorkers 中启用或用 --worker qwen 指定）",
      "keywords": [
        "qwen",
        "通义"
      ]
    }
  },
